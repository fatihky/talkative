{
  "name": "@fatihky/talkative",
  "version": "0.2.2",
  "description": "Self-hosted multi-provider AI chat app",
  "license": "MIT",
  "author": "Fatih Kaya <1994274@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatihky/talkative.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "talkative": "./bin/talkative.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "instrumentation.mjs",
    "drizzle/*.sql",
    "drizzle/meta/_journal.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"--import ./instrumentation.mjs $NODE_OPTIONS\" waku dev",
    "build": "waku build && rolldown -c rolldown.config.mjs",
    "prepublishOnly": "pnpm build",
    "start": "NODE_OPTIONS=\"--import ./instrumentation.mjs $NODE_OPTIONS\" waku start",
    "typegen": "waku router typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "admin:grant": "node --experimental-strip-types scripts/admin.ts grant",
    "admin:revoke": "node --experimental-strip-types scripts/admin.ts revoke",
    "keys:rekey": "node --experimental-strip-types scripts/rekey.ts",
    "uploads:gc": "node --experimental-strip-types scripts/uploads-gc.ts",
    "check": "biome check --write"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@streamdown/mermaid": "^1.0.3",
    "better-auth": "^1.7.14",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.64.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-server-dom-webpack": "~19.3.1",
    "streamdown": "^2.7.1",
    "waku": "1.0.0-rc.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "rolldown": "1.2.16",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}

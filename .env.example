# --- required ---

# PostgreSQL connection string
DATABASE_URL=postgres://localhost:5432/talkative

# Better Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Public base URL of the app, used by Better Auth for base URL and trusted origins.
# No default: set this to the exact scheme + host users reach the app at
# (e.g. https://chat.example.com, or http://localhost:3000 for local dev).
# On Coolify-based deployments this can be set to $SERVICE_URL_APP.
BETTER_AUTH_URL=

# Comma-separated list of additional trusted origins for Better Auth
BETTER_AUTH_TRUSTED_ORIGINS=

# --- optional ---

# Redis connection string; used to cache provider model catalogs.
# Falls back to this default, and the app runs without Redis.
REDIS_URL=redis://localhost:6379

# How often (ms) to refetch provider model catalogs in the background,
# keeping the redis cache warm without a client's ?refresh=1. Set to 0
# to disable the background sweep entirely. Defaults to 5 minutes (300000).
CATALOG_REFRESH_MS=300000

# Directory for uploaded images. Defaults to ./uploads for bare Node deployments;
# Docker-based deployments should point this at the mounted uploads volume.
UPLOADS_DIR=uploads

# Provider API key encryption (optional). When set, provider_connections.api_key
# is sealed at rest with AES-256-GCM. Every listed version can decrypt; new
# values are sealed with PROVIDER_KEY_ENC_ACTIVE (defaults to the last listed).
# Generate a key with: openssl rand -base64 32
# Then run `pnpm db:migrate` if needed and `pnpm keys:rekey` to seal existing rows.
# Rotate by appending a new version and running `pnpm keys:rekey` again.
# Leave unset to store api keys in plaintext (the app logs a warning at boot).
PROVIDER_KEY_ENC_KEYS=
PROVIDER_KEY_ENC_ACTIVE=

# --- tool credentials (optional; each enables the matching tool) ---

# web_search backends (also used by http_fetch)
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
SEARXNG_URL=
EXA_API_KEY=

# http_fetch backend
SCRAPEDO_API_KEY=

# GitHub tools; optional but recommended for higher rate limits
GITHUB_PAT=

# The env-defined keys above are shared with users per the "environment key access"
# site setting (admins only): `all` shares with everyone, `admins` (default) shares
# with admins only, `none` requires every user to bring their own key. Users' own
# keys are set in the app (Settings → Tool keys) and are stored encrypted.
